root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.py]
trim_trailing_whitespace = true
max_line_length = 88
indent_size = 4
quote_type = single
max_complexity = 10
enable_sort_imports = true
